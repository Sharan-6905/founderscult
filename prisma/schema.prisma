datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  contact   String?
  createdAt DateTime @default(now())
}
